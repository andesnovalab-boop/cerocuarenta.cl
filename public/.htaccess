# SPA routing — CeroCuarenta (React Router)
# Sirve index.html para cualquier ruta del cliente (/club, /admin, /product/..., etc.)
# así no da 404 al entrar directo por URL o al refrescar.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No reescribir archivos o carpetas que SÍ existen (assets, imágenes, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Todo lo demás → index.html (React Router resuelve la ruta)
  RewriteRule ^ /index.html [L]
</IfModule>
