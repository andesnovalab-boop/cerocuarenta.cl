# CeroCuarenta — reglas del sitio (Apache/LiteSpeed de Hostinger)
# HTTP → HTTPS ya lo hace Hostinger antes de llegar aquí.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. www.cerocuarenta.cl → cerocuarenta.cl (una sola dirección para Google)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. URLs limpias: /index.html → /  y  /galeria.html → /galeria
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 3. /galeria/ → /galeria
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^./]+)/$ /$1 [R=301,L]

  # spa.html es interno (ver regla 5): si alguien entra a /spa, va a la portada
  RewriteRule ^spa$ / [R=301,L]

  # 4. Páginas con HTML propio (lo genera scripts/prerender-seo.mjs): /galeria → galeria.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^./]+)$ $1.html [L]

  # 5. Todo lo demás (/product/..., /admin, /checkout...) → spa.html y React Router resuelve.
  #    spa.html es la portada sin canonical: lo pone React con la ruta real.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /spa.html [L]
</IfModule>
