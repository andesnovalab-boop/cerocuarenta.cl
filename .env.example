# ─────────────────────────────────────────────────────────────
# CeroCuarenta — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a git — ya está en .gitignore
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Panel: https://supabase.com/dashboard/project/[proyecto]/settings/api
VITE_SUPABASE_URL=https://[proyecto].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-key...
SUPABASE_URL=https://[proyecto].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# ── MercadoPago ──────────────────────────────────────────────
# Panel: https://www.mercadopago.cl/developers/panel/app
# Usar credenciales TEST-... para pruebas, APP_USR-... para producción
MP_ACCESS_TOKEN=APP_USR-...access-token...
VITE_MP_PUBLIC_KEY=APP_USR-...public-key...

# OBLIGATORIO en producción — se obtiene al configurar el webhook en MP:
# Panel MP > Tu integración > Webhooks > agregar URL > copiar "Clave secreta"
# URL del webhook: https://cerocuarenta.cl/api/webhooks/mp
# Eventos a suscribir: payment
MP_WEBHOOK_SECRET=

# ── App ──────────────────────────────────────────────────────
# Desarrollo: http://localhost:3000
# Producción: https://cerocuarenta.cl  (sin trailing slash, sin www)
APP_URL=http://localhost:3000

NODE_ENV=development   # cambiar a "production" en servidor
PORT=3000

# Email del administrador (acceso al panel /admin)
VITE_ADMIN_EMAIL=tu@email.com
